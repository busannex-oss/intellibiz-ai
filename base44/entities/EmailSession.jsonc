{
  "name": "EmailSession",
  "type": "object",
  "properties": {
    "message_id": {
      "type": "string",
      "description": "Unique email ID"
    },
    "project_id": {
      "type": "string"
    },
    "from_email": {
      "type": "string"
    },
    "to_email": {
      "type": "string"
    },
    "cc": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "direction": {
      "type": "string",
      "enum": [
        "inbound",
        "outbound"
      ]
    },
    "subject": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "html_body": {
      "type": "string"
    },
    "assigned_agent_id": {
      "type": "string"
    },
    "assigned_agent_name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "received",
        "opened",
        "replied",
        "archived"
      ],
      "default": "received"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "replied_at": {
      "type": "string",
      "format": "date-time"
    },
    "ai_generated": {
      "type": "boolean",
      "default": false
    },
    "thread_id": {
      "type": "string"
    },
    "sentiment": {
      "type": "string",
      "enum": [
        "positive",
        "neutral",
        "negative",
        "urgent"
      ]
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "urgent"
      ],
      "default": "medium"
    },
    "requires_response": {
      "type": "boolean",
      "default": false
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "filename": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "size": {
            "type": "number"
          }
        }
      }
    },
    "ai_summary": {
      "type": "string"
    }
  },
  "required": [
    "message_id",
    "project_id",
    "direction",
    "subject"
  ],
  "rls": {
    "create": {},
    "read": {},
    "update": {},
    "delete": {}
  }
}
{
  "name": "AIAgent",
  "type": "object",
  "properties": {
    "agent_key": {
      "type": "string",
      "description": "Machine-readable agent identifier"
    },
    "first_name": {
      "type": "string"
    },
    "last_name": {
      "type": "string"
    },
    "age": {
      "type": "number"
    },
    "job_title": {
      "type": "string"
    },
    "personality": {
      "type": "string"
    },
    "responsibilities": {
      "type": "string"
    },
    "headshot_url": {
      "type": "string"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "agent_key",
    "first_name"
  ],
  "rls": {
    "create": {},
    "read": {},
    "update": {},
    "delete": {}
  }
}
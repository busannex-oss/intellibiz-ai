{
  "name": "AIAgent",
  "type": "object",
  "properties": {
    "agent_key": {
      "type": "string",
      "description": "Machine-readable agent identifier"
    },
    "first_name": {
      "type": "string"
    },
    "last_name": {
      "type": "string"
    },
    "age": {
      "type": "number"
    },
    "gender": {
      "type": "string",
      "enum": [
        "male",
        "female",
        "non-binary"
      ],
      "default": "male"
    },
    "job_title": {
      "type": "string"
    },
    "personality": {
      "type": "string"
    },
    "tone": {
      "type": "string",
      "description": "Communication tone and style (e.g. Warm and advisory, Direct and precise)"
    },
    "education": {
      "type": "string",
      "description": "Educational background and credentials"
    },
    "responsibilities": {
      "type": "string"
    },
    "headshot_url": {
      "type": "string"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "agent_key",
    "first_name"
  ],
  "rls": {
    "create": {},
    "read": {},
    "update": {},
    "delete": {}
  }
}
{
  "name": "CallSession",
  "type": "object",
  "properties": {
    "call_sid": {
      "type": "string",
      "description": "Twilio call ID"
    },
    "project_id": {
      "type": "string"
    },
    "caller_number": {
      "type": "string"
    },
    "called_number": {
      "type": "string"
    },
    "direction": {
      "type": "string",
      "enum": [
        "inbound",
        "outbound"
      ]
    },
    "assigned_agent_id": {
      "type": "string",
      "description": "AI agent ID handling the call"
    },
    "assigned_agent_name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "ringing",
        "active",
        "completed",
        "failed",
        "no_answer"
      ],
      "default": "ringing"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "ended_at": {
      "type": "string",
      "format": "date-time"
    },
    "duration_seconds": {
      "type": "number"
    },
    "recording_url": {
      "type": "string"
    },
    "transcription": {
      "type": "string"
    },
    "call_transcript": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "timestamp": {
            "type": "string"
          },
          "speaker": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      }
    },
    "caller_info": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "company": {
          "type": "string"
        },
        "previous_calls": {
          "type": "number"
        }
      }
    },
    "purpose": {
      "type": "string"
    },
    "ai_summary": {
      "type": "string"
    },
    "sentiment": {
      "type": "string",
      "enum": [
        "positive",
        "neutral",
        "negative"
      ]
    },
    "action_items": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "follow_up_required": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "call_sid",
    "project_id",
    "direction"
  ],
  "rls": {
    "create": {},
    "read": {},
    "update": {},
    "delete": {}
  }
}
{
  "name": "SMSSession",
  "type": "object",
  "properties": {
    "message_sid": {
      "type": "string",
      "description": "Twilio message ID"
    },
    "project_id": {
      "type": "string"
    },
    "from_number": {
      "type": "string"
    },
    "to_number": {
      "type": "string"
    },
    "direction": {
      "type": "string",
      "enum": [
        "inbound",
        "outbound"
      ]
    },
    "body": {
      "type": "string"
    },
    "assigned_agent_id": {
      "type": "string"
    },
    "assigned_agent_name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "sent",
        "received",
        "delivered",
        "failed"
      ],
      "default": "sent"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "ai_generated": {
      "type": "boolean",
      "default": false
    },
    "conversation_id": {
      "type": "string"
    },
    "sentiment": {
      "type": "string",
      "enum": [
        "positive",
        "neutral",
        "negative"
      ]
    },
    "requires_response": {
      "type": "boolean",
      "default": false
    },
    "media_urls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "message_sid",
    "project_id",
    "direction",
    "body"
  ],
  "rls": {
    "create": {},
    "read": {},
    "update": {},
    "delete": {}
  }
}